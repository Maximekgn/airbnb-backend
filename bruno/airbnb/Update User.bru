meta {
  name: Update User
  type: http
  seq: 8
}

patch {
  url: http://localhost:3000/users/cljs1234567890abcdefghij
  body: json
  auth: inherit
}

body:json {
  {
    "firstName": "Jean",
    "lastName": "Dupont",
    "email": "jean.dupont@example.com",
    "tel": "+33612345678"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("Update should return updated user", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().firstName).to.equal("Jean");
  });
}
