meta {
  name: Get Current User
  type: http
  seq: 5
}

get {
  url: http://localhost:3000/users/me
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("Response should contain user data", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.include("id");
    expect(res.getBody()).to.include("email");
  });
}
