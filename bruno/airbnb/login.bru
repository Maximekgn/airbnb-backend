meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: http://localhost:3000/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "kogonmaxime@gmail.com",
    "password": "password"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("Login should return access token", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.include("access_token");
    expect(res.getBody()).to.include("user");
  });
}
